# Agent homes and sign-ins: the rig agent's project and home directories,
# and those of the other coding agents rig can run. They hold sessions,
# settings and credentials, and never belong in the repository.
.rig/
.claude/
.codex/
.grok/
.gemini/
.cursor/
auth.json
.credentials.json
*-oauth-token

# nodejs stuff
node_modules/
dist/

# LanceDB example/test store artifacts (created at the workspace root)
/data/

# The `discord_bot` example is its own workspace; its lockfile pins the
# unpatchable `serenity`/`rustls` 0.22 graph that the root workspace excludes.
examples/discord_bot/Cargo.lock
